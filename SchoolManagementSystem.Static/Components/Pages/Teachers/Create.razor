@page "/teachers/create"
@using SchoolManagementSystem.Data.Models
@using SchoolManagementSystem.Services
@inject TeacherService TeacherService
@inject NavigationManager Nav
@attribute [Authorize(Policy = "AdminOnly")]

<PageTitle>Add Teacher</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1"><i class="bi bi-person-plus me-2 text-primary"></i>Add Teacher</h4>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="teachers">Teachers</a></li>
            <li class="breadcrumb-item active">Add</li>
        </ol></nav>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <ul class="nav nav-tabs card-header-tabs">
                    <li class="nav-item"><button type="button" class="nav-link @(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">Personal Info</button></li>
                    <li class="nav-item"><button type="button" class="nav-link @(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">Employment</button></li>
                    <li class="nav-item"><button type="button" class="nav-link @(activeTab == 3 ? "active" : "")" @onclick="() => activeTab = 3">Account</button></li>
                </ul>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(errorMsg))
                {
                    <div class="alert alert-danger">@errorMsg</div>
                }
                <EditForm Model="model" OnValidSubmit="Submit">
                    <DataAnnotationsValidator />

                    @if (activeTab == 1)
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">First Name *</label>
                                <InputText class="form-control" @bind-Value="model.FirstName" />
                                <ValidationMessage For="() => model.FirstName" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Last Name *</label>
                                <InputText class="form-control" @bind-Value="model.LastName" />
                                <ValidationMessage For="() => model.LastName" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Father Name</label>
                                <InputText class="form-control" @bind-Value="model.FatherName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Gender *</label>
                                <InputSelect class="form-select" @bind-Value="model.Gender">
                                    <option value="">Select...</option>
                                    @foreach (var g in Enum.GetValues<Gender>())
                                    {
                                        <option value="@g">@g</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Date of Birth</label>
                                <InputDate class="form-control" @bind-Value="model.DateOfBirth" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">CNIC *</label>
                                <InputText class="form-control" placeholder="XXXXX-XXXXXXX-X" @bind-Value="model.CNIC" />
                                <ValidationMessage For="() => model.CNIC" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone *</label>
                                <InputText class="form-control" @bind-Value="model.Phone" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" @bind-Value="model.Email" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Address</label>
                                <InputTextArea class="form-control" rows="2" @bind-Value="model.Address" />
                            </div>
                        </div>
                        <div class="mt-3 text-end">
                            <button type="button" class="btn btn-primary" @onclick="() => activeTab = 2">Next <i class="bi bi-chevron-right"></i></button>
                        </div>
                    }

                    @if (activeTab == 2)
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Employee Code</label>
                                <input class="form-control" value="@generatedCode" readonly />
                                <small class="text-muted">Auto-generated on save</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Joining Date *</label>
                                <InputDate class="form-control" @bind-Value="model.JoiningDate" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Qualification *</label>
                                <InputText class="form-control" placeholder="e.g. M.Sc Physics" @bind-Value="model.Qualification" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Specialization</label>
                                <InputText class="form-control" @bind-Value="model.Specialization" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Monthly Salary (PKR) *</label>
                                <InputNumber class="form-control" @bind-Value="model.MonthlySalary" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Bank Account</label>
                                <InputText class="form-control" @bind-Value="model.BankAccount" />
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <InputCheckbox class="form-check-input" @bind-Value="model.IsActive" id="isActive" />
                                    <label class="form-check-label" for="isActive">Active</label>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => activeTab = 1"><i class="bi bi-chevron-left"></i> Back</button>
                            <button type="button" class="btn btn-primary" @onclick="() => activeTab = 3">Next <i class="bi bi-chevron-right"></i></button>
                        </div>
                    }

                    @if (activeTab == 3)
                    {
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Creating an account allows this teacher to log in to the system.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Login Email</label>
                                <input class="form-control" value="@model.Email" readonly />
                                <small class="text-muted">Uses teacher email</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Initial Password</label>
                                <InputText type="password" class="form-control" @bind-Value="initialPassword" placeholder="Min 6 chars" />
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input" id="createAccount" @bind="createAccount" />
                                    <label class="form-check-label" for="createAccount">Create login account for this teacher</label>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => activeTab = 2"><i class="bi bi-chevron-left"></i> Back</button>
                            <button type="submit" class="btn btn-success" disabled="@isSaving">
                                @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                <i class="bi bi-check-lg me-1"></i>Save Teacher
                            </button>
                        </div>
                    }
                </EditForm>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Preview</div>
            <div class="card-body text-center">
                <div class="avatar-lg bg-primary rounded-circle d-flex align-items-center justify-content-center text-white mx-auto mb-3" style="width:80px;height:80px;font-size:2rem;">
                    @(string.IsNullOrEmpty(model.FirstName) ? "?" : model.FirstName[0])
                </div>
                <h6>@model.FirstName @model.LastName</h6>
                <p class="text-muted small mb-1">@model.Qualification</p>
                <p class="text-muted small">@model.Phone</p>
            </div>
        </div>
    </div>
</div>

@code {
    Teacher model = new() { JoiningDate = DateTime.Today, IsActive = true };
    int activeTab = 1;
    string generatedCode = "Auto-generated";
    string errorMsg = "", initialPassword = "Teacher@123";
    bool isSaving, createAccount = true;

    async Task Submit()
    {
        isSaving = true; errorMsg = "";
        try
        {
            await TeacherService.CreateAsync(model, createAccount ? initialPassword : null);
            Nav.NavigateTo("teachers");
        }
        catch (Exception ex) { errorMsg = ex.Message; }
        finally { isSaving = false; }
    }
}
