@page "/exams/create"
@using Microsoft.AspNetCore.Authorization
@using SchoolManagementSystem.Data.Models
@using SchoolManagementSystem.Services
@inject ExamService ExamService
@inject ClassService ClassService
@inject SubjectService SubjectService
@inject NavigationManager Nav
@attribute [Authorize(Policy = "TeacherOrAdmin")]

<PageTitle>Create Exam</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1"><i class="bi bi-plus-circle me-2 text-primary"></i>Create Exam</h4>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="exams">Exams</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol></nav>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(errorMsg))
                { <div class="alert alert-danger">@errorMsg</div> }

                <EditForm Model="model" OnValidSubmit="Submit">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Exam Name *</label>
                            <InputText class="form-control" @bind-Value="model.Name" placeholder="e.g. First Term Exam 2025" />
                            <ValidationMessage For="() => model.Name" class="text-danger small" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Type *</label>
                            <InputSelect class="form-select" @bind-Value="model.Type">
                                @foreach (var t in Enum.GetValues<ExamType>())
                                { <option value="@t">@t</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Start Date *</label>
                            <InputDate class="form-control" @bind-Value="model.StartDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">End Date *</label>
                            <InputDate class="form-control" @bind-Value="model.EndDate" />
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h6 class="mb-3">Exam Schedules (per Class/Subject)</h6>

                    <div class="mb-3">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-3">
                                <select class="form-select form-select-sm" @bind="newSchedule.ClassId" @bind:after="LoadSubjects">
                                    <option value="0">Select Class...</option>
                                    @foreach (var c in classes)
                                    { <option value="@c.Id">@c.Name</option> }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select form-select-sm" @bind="newSchedule.SubjectId">
                                    <option value="0">Select Subject...</option>
                                    @foreach (var s in availableSubjects)
                                    { <option value="@s.Id">@s.Name</option> }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <input type="date" class="form-control form-control-sm" @bind="newSchedule.ExamDate" />
                            </div>
                            <div class="col-md-2">
                                <input type="number" class="form-control form-control-sm" placeholder="Total Marks" @bind="newSchedule.TotalMarks" />
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-sm btn-outline-primary w-100" @onclick="AddSchedule">
                                    <i class="bi bi-plus"></i> Add
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (schedules.Count > 0)
                    {
                        <table class="table table-sm table-bordered">
                            <thead class="table-light"><tr><th>Class</th><th>Subject</th><th>Date</th><th>Total Marks</th><th>Pass Marks</th><th></th></tr></thead>
                            <tbody>
                                @for (int i = 0; i < schedules.Count; i++)
                                {
                                    var idx = i;
                                    var sch = schedules[i];
                                    <tr>
                                        <td>@classes.FirstOrDefault(c => c.Id == sch.ClassId)?.Name</td>
                                        <td>@allSubjects.FirstOrDefault(s => s.Id == sch.SubjectId)?.Name</td>
                                        <td>@sch.ExamDate.ToString("dd MMM")</td>
                                        <td>@sch.TotalMarks</td>
                                        <td>@sch.PassMarks</td>
                                        <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => schedules.RemoveAt(idx)"><i class="bi bi-x"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <div class="mt-4 d-flex gap-2 justify-content-end">
                        <a href="exams" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Create Exam
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    Exam model = new() { StartDate = DateTime.Today, EndDate = DateTime.Today.AddDays(7) };
    List<Class> classes = [];
    List<Subject> availableSubjects = [], allSubjects = [];
    List<ExamSchedule> schedules = [];
    ExamSchedule newSchedule = new() { ExamDate = DateTime.Today, TotalMarks = 100, PassMarks = 40 };
    string errorMsg = "";
    bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        classes = await ClassService.GetAllAsync();
        allSubjects = await SubjectService.GetAllAsync();
    }

    async Task LoadSubjects()
    {
        if (newSchedule.ClassId > 0)
            availableSubjects = await SubjectService.GetSubjectsByClassAsync(newSchedule.ClassId);
        else availableSubjects = allSubjects;
    }

    void AddSchedule()
    {
        if (newSchedule.ClassId == 0 || newSchedule.SubjectId == 0) return;
        schedules.Add(new ExamSchedule
        {
            ClassId = newSchedule.ClassId, SubjectId = newSchedule.SubjectId,
            ExamDate = newSchedule.ExamDate, TotalMarks = newSchedule.TotalMarks, PassMarks = newSchedule.TotalMarks / 2
        });
        newSchedule = new() { ExamDate = DateTime.Today, TotalMarks = 100, PassMarks = 40 };
    }

    async Task Submit()
    {
        isSaving = true; errorMsg = "";
        try
        {
            model.Schedules = schedules;
            var year = await ExamService.GetCurrentAcademicYearIdAsync();
            model.AcademicYearId = year;
            await ExamService.CreateAsync(model);
            Nav.NavigateTo("exams");
        }
        catch (Exception ex) { errorMsg = ex.Message; }
        finally { isSaving = false; }
    }
}
