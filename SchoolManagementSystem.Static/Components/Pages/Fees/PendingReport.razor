@page "/fees/pending"
@using SchoolManagementSystem.Data.Models
@using SchoolManagementSystem.Services
@inject FeeService FeeService
@inject ClassService ClassService
@inject IJSRuntime JS
@attribute [Authorize(Policy = "AccountantOrAdmin")]

<PageTitle>Pending Fees Report</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1"><i class="bi bi-exclamation-triangle me-2 text-danger"></i>Pending Fees Report</h4>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="">Dashboard</a></li>
            <li class="breadcrumb-item active">Pending Fees</li>
        </ol></nav>
    </div>
    <button class="btn btn-outline-success" @onclick="ExportExcel"><i class="bi bi-file-earmark-excel me-1"></i>Export Excel</button>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Class</label>
                <select class="form-select" @bind="filterClassId">
                    <option value="0">All Classes</option>
                    @foreach (var c in classes)
                    { <option value="@c.Id">@c.Name</option> }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Month</label>
                <select class="form-select" @bind="filterMonth">
                    <option value="0">All Months</option>
                    @for (int m = 1; m <= 12; m++)
                    { <option value="@m">@(new DateTime(2024, m, 1).ToString("MMMM"))</option> }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Year</label>
                <select class="form-select" @bind="filterYear">
                    @for (int y = DateTime.Now.Year - 1; y <= DateTime.Now.Year + 1; y++)
                    { <option value="@y">@y</option> }
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" @onclick="Load">
                    <i class="bi bi-search me-1"></i>Generate Report
                </button>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (loaded)
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h6>Total Pending</h6>
                    <h4>PKR @pendingVouchers.Sum(v => v.PendingAmount).ToString("N0")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <h6>Overdue Vouchers</h6>
                    <h4>@pendingVouchers.Count(v => v.Status == VoucherStatus.Overdue)</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h6>Students with Dues</h6>
                    <h4>@pendingVouchers.Select(v => v.StudentId).Distinct().Count()</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-secondary text-white">
                <div class="card-body">
                    <h6>Total Vouchers</h6>
                    <h4>@pendingVouchers.Count</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Student</th>
                        <th>Reg. No.</th>
                        <th>Class</th>
                        <th>Month</th>
                        <th>Total</th>
                        <th>Paid</th>
                        <th>Pending</th>
                        <th>Due Date</th>
                        <th>Days Overdue</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in pendingVouchers.OrderByDescending(x => x.PendingAmount))
                    {
                        var daysOverdue = v.DueDate < DateTime.Today ? (int)(DateTime.Today - v.DueDate).TotalDays : 0;
                        <tr>
                            <td class="fw-semibold">@v.Student?.FullName</td>
                            <td>@v.Student?.RegistrationNumber</td>
                            <td>@v.Student?.Section?.Class?.Name</td>
                            <td>@(new DateTime(v.Year, v.Month, 1).ToString("MMM yyyy"))</td>
                            <td>@v.TotalAmount.ToString("N0")</td>
                            <td class="text-success">@v.PaidAmount.ToString("N0")</td>
                            <td class="text-danger fw-semibold">@v.PendingAmount.ToString("N0")</td>
                            <td>@v.DueDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (daysOverdue > 0)
                                {
                                    <span class="badge bg-danger">@daysOverdue days</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><span class="badge @GetStatusBadge(v.Status)">@v.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    List<Class> classes = [];
    List<FeeVoucher> pendingVouchers = [];
    int filterClassId, filterMonth, filterYear = DateTime.Now.Year;
    bool isLoading, loaded;

    protected override async Task OnInitializedAsync()
    {
        classes = await ClassService.GetAllAsync();
    }

    async Task Load()
    {
        isLoading = true; loaded = false;
        pendingVouchers = await FeeService.GetPendingReportAsync(filterClassId == 0 ? null : filterClassId, filterMonth == 0 ? null : filterMonth, filterYear);
        isLoading = false; loaded = true;
    }

    async Task ExportExcel()
    {
        var bytes = await FeeService.ExportPendingToExcelAsync(filterClassId == 0 ? null : filterClassId, filterMonth == 0 ? null : filterMonth, filterYear);
        await JS.InvokeVoidAsync("downloadFile", "pending-fees.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
    }

    string GetStatusBadge(VoucherStatus s) => s switch
    {
        VoucherStatus.Paid => "bg-success",
        VoucherStatus.Partial => "bg-warning text-dark",
        VoucherStatus.Overdue => "bg-danger",
        _ => "bg-secondary"
    };
}
