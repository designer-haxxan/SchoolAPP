@page "/users"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using SchoolManagementSystem.Data
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@attribute [Authorize(Policy = "AdminOnly")]

<PageTitle>User Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1"><i class="bi bi-people me-2 text-primary"></i>User Management</h4>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
            <li class="breadcrumb-item active">Users</li>
        </ol></nav>
    </div>
    <a href="/users/create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Add User</a>
</div>

@if (isLoading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <div class="input-group" style="max-width:300px">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Search users..." value="@searchTerm" @oninput="Filter" />
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>User</th><th>Email</th><th>Roles</th><th>Status</th><th>Created</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var u in filteredUsers)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white" style="width:36px;height:36px;font-size:14px">
                                        @(u.User.FullName?.FirstOrDefault() ?? u.User.Email?.FirstOrDefault() ?? '?')
                                    </div>
                                    <div class="fw-semibold">@(u.User.FullName ?? u.User.Email)</div>
                                </div>
                            </td>
                            <td>@u.User.Email</td>
                            <td>
                                @foreach (var r in u.Roles)
                                {
                                    <span class="badge @GetRoleBadge(r) me-1">@r</span>
                                }
                            </td>
                            <td>
                                @if (u.User.IsActive)
                                { <span class="badge bg-success">Active</span> }
                                else
                                { <span class="badge bg-secondary">Inactive</span> }
                            </td>
                            <td>@u.User.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-@(u.User.IsActive ? "warning" : "success")" @onclick="() => ToggleActive(u.User)">
                                    @(u.User.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small">@filteredUsers.Count users shown</div>
    </div>
}

@code {
    List<UserWithRoles> allUsers = [], filteredUsers = [];
    string searchTerm = "";
    bool isLoading = true;

    record UserWithRoles(ApplicationUser User, IList<string> Roles);

    protected override async Task OnInitializedAsync()
    {
        var users = UserManager.Users.ToList();
        var withRoles = new List<UserWithRoles>();
        foreach (var u in users)
        {
            var roles = await UserManager.GetRolesAsync(u);
            withRoles.Add(new UserWithRoles(u, roles));
        }
        allUsers = withRoles;
        filteredUsers = allUsers;
        isLoading = false;
    }

    void Filter(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        filteredUsers = string.IsNullOrEmpty(searchTerm)
            ? allUsers
            : allUsers.Where(u => (u.User.FullName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true)
                                  || (u.User.Email?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true)).ToList();
    }

    async Task ToggleActive(ApplicationUser user)
    {
        user.IsActive = !user.IsActive;
        await UserManager.UpdateAsync(user);
    }

    string GetRoleBadge(string r) => r switch
    {
        "Admin" => "bg-danger", "Teacher" => "bg-primary",
        "Accountant" => "bg-success", "Parent" => "bg-info",
        _ => "bg-secondary"
    };
}
