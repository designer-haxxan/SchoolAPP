@page "/fees"
@rendermode InteractiveServer
@using SchoolManagementSystem.Services
@inject FeeService FeeService
@inject SettingsService SettingsService
@inject IJSRuntime JS
@attribute [Authorize(Policy = "AccountantOrAdmin")]

<PageTitle>Fee Management</PageTitle>

<div class="page-header reveal">
    <div>
        <h1 class="page-title"><i class="bi bi-cash-coin me-2"></i>Fee Management</h1>
        <p class="page-subtitle">@monthLabel · collections, vouchers and dues for @(schoolName)</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="/fees/vouchers" class="btn btn-outline-primary btn-sm"><i class="bi bi-lightning me-1"></i>Generate Vouchers</a>
        <a href="/fees/collect" class="btn btn-success btn-sm"><i class="bi bi-cash-stack me-1"></i>Collect Fee</a>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <!-- Summary cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="stat-card teal reveal" style="--i:0">
                <div class="stat-icon teal"><i class="bi bi-cash-stack"></i></div>
                <div class="stat-info">
                    <div class="stat-value money"><span data-countup="@((long)monthlyCollection)" data-prefix="Rs. "></span></div>
                    <div class="stat-label">Collected this month</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card navy reveal" style="--i:1">
                <div class="stat-icon navy"><i class="bi bi-receipt"></i></div>
                <div class="stat-info">
                    <div class="stat-value money"><span data-countup="@((long)stats.Billed)" data-prefix="Rs. "></span></div>
                    <div class="stat-label">Billed for @monthShort</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card red reveal" style="--i:2">
                <div class="stat-icon red"><i class="bi bi-exclamation-circle-fill"></i></div>
                <div class="stat-info">
                    <div class="stat-value"><span data-countup="@pendingCount"></span></div>
                    <div class="stat-label">Pending vouchers</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card orange reveal" style="--i:3">
                <div class="stat-icon orange"><i class="bi bi-clock-history"></i></div>
                <div class="stat-info">
                    <div class="stat-value"><span data-countup="@overdueCount"></span></div>
                    <div class="stat-label">Overdue vouchers</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Collection rate + trend -->
    <div class="row g-3 mb-4">
        <div class="col-xl-4">
            <div class="card shadow-sm h-100 reveal" style="--i:4">
                <div class="card-body d-flex flex-wrap align-items-center gap-3">
                    <svg class="collect-ring" viewBox="0 0 120 120" width="100" height="100" role="img"
                         aria-label="Collection rate @stats.Percentage percent">
                        <circle class="ring-track" cx="60" cy="60" r="50" />
                        <circle class="ring-value" cx="60" cy="60" r="50" style="--pct:@pctCss" />
                    </svg>
                    <div>
                        <div class="small text-muted">Collection rate</div>
                        <div class="fs-2 fw-bold lh-1 mb-1"><span data-countup="@stats.Percentage" data-suffix="%"></span></div>
                        <div class="small text-muted">@MoneyFormat.Pkr(stats.Collected) of @MoneyFormat.Pkr(stats.Billed)</div>
                        @if (stats.Outstanding > 0)
                        {
                            <div class="small text-danger mt-1"><i class="bi bi-arrow-down-right me-1"></i>@MoneyFormat.Pkr(stats.Outstanding) outstanding</div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-8">
            <div class="card shadow-sm h-100 reveal" style="--i:5">
                <div class="card-header bg-white fw-semibold d-flex justify-content-between">
                    <span>Cash collected — last 6 months</span>
                    <span class="small text-muted">Rs.</span>
                </div>
                <div class="card-body">
                    <div style="position:relative;height:200px;">
                        <canvas id="feeTrendChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Module cards -->
    <div class="row g-3">
        @{ int i = 6; }
        @foreach (var m in modules)
        {
            var delay = i++;
            <div class="col-md-6 col-lg-4 reveal" style="--i:@delay">
                <a href="@m.Href" class="module-card text-decoration-none">
                    <div class="module-icon @m.IconClass">
                        <i class="bi @m.Icon"></i>
                    </div>
                    <div class="module-info">
                        <h6>@m.Title</h6>
                        <p>@m.Description</p>
                    </div>
                    <i class="bi bi-chevron-right module-arrow"></i>
                </a>
            </div>
        }
    </div>
}

@code {
    record ModuleItem(string Title, string Description, string Href, string Icon, string IconClass);

    static readonly ModuleItem[] modules =
    [
        new("Fee Structure", "Define class-wise fee heads and amounts for the academic year", "/fees/structure", "bi-table", "bg-primary-subtle text-primary"),
        new("Fee Vouchers", "Generate monthly vouchers, search them and print challans", "/fees/vouchers", "bi-receipt", "bg-info-subtle text-info"),
        new("Collect Payment", "Record cash, bank challan, JazzCash or Easypaisa payments", "/fees/collect", "bi-cash-coin", "bg-success-subtle text-success"),
        new("Pending / Overdue", "Chase unpaid and overdue vouchers by class and month", "/fees/pending", "bi-exclamation-triangle-fill", "bg-danger-subtle text-danger"),
        new("Scholarships & Discounts", "Merit, sibling and need-based concessions per student", "/fees/scholarships", "bi-award-fill", "bg-warning-subtle text-warning"),
    ];

    bool isLoading = true;
    bool chartPending;
    string schoolName = "your school";
    string monthLabel = "", monthShort = "";
    decimal monthlyCollection;
    CollectionStats stats = new(0, 0);
    string pctCss = "0";
    int pendingCount, overdueCount;
    List<(string Month, decimal Amount)> trend = [];

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.Today;
        monthLabel = now.ToString("MMMM yyyy");
        monthShort = now.ToString("MMM yyyy");
        schoolName = (await SettingsService.GetSchoolSettingsAsync())?.SchoolName ?? schoolName;

        monthlyCollection = await FeeService.GetMonthlyCollectionAsync(now.Month, now.Year);
        stats = await FeeService.GetCollectionStatsAsync(now.Month, now.Year);
        pctCss = (stats.Percentage / 100.0).ToString(System.Globalization.CultureInfo.InvariantCulture);
        (pendingCount, overdueCount) = await FeeService.GetVoucherCountsAsync(now.Year);
        trend = await FeeService.GetMonthlyCollectionSummaryAsync(6);

        isLoading = false;
        chartPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!chartPending) return;
        chartPending = false;
        await JS.InvokeVoidAsync("initChart", "feeTrendChart", "bar",
            trend.Select(t => t.Month).ToArray(),
            trend.Select(t => (double)t.Amount).ToArray(),
            "Collected", "rgba(13,148,136,0.8)");
    }
}
