@page "/subjects"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "StaffOnly")]
@inject SubjectService SubjectSvc
@inject ClassService ClassSvc
@inject TeacherService TeacherSvc
@inject SettingsService SettingsSvc

<PageTitle>Subjects</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="bi bi-book-fill me-2"></i>Subjects</h1>
        <p class="page-subtitle">Manage subjects and their class assignments</p>
    </div>
    <AuthorizeView Roles="Admin">
        <button class="btn btn-primary" @onclick="() => { _form = new Subject(); _showForm = true; }">
            <i class="bi bi-plus-circle me-1"></i> Add Subject
        </button>
    </AuthorizeView>
</div>

<div class="school-card">
    <div class="card-body p-0">
        <table class="table-school w-100">
            <thead><tr><th>Subject Name</th><th>Code</th><th>Type</th><th>Total Marks</th><th>Pass Marks</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var s in _subjects)
                {
                    <tr>
                        <td><strong>@s.Name</strong></td>
                        <td><code>@s.Code</code></td>
                        <td>@s.Type</td>
                        <td>@s.TotalMarks</td>
                        <td>@s.PassMarks</td>
                        <td><span class="badge-status @(s.IsActive ? "badge-active" : "badge-inactive")">@(s.IsActive ? "Active" : "Inactive")</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(s)"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(s.Id)"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (_showForm)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_form.Id == 0 ? "Add" : "Edit") Subject</h5>
                    <button type="button" class="btn-close" @onclick="() => _showForm = false"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="_form" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label form-label-required">Subject Name</label>
                                <InputText @bind-Value="_form.Name" class="form-control" placeholder="Mathematics" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label form-label-required">Code</label>
                                <InputText @bind-Value="_form.Code" class="form-control" placeholder="MATH-01" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Type</label>
                                <InputSelect @bind-Value="_form.Type" class="form-select">
                                    @foreach (var t in Enum.GetValues<SubjectType>())
                                    { <option value="@t">@t</option> }
                                </InputSelect>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Total Marks</label>
                                <InputNumber @bind-Value="_form.TotalMarks" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Pass Marks</label>
                                <InputNumber @bind-Value="_form.PassMarks" class="form-control" />
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="_form.IsActive" class="form-check-input" id="active" />
                                    <label class="form-check-label" for="active">Active</label>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-primary">Save Subject</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => _showForm = false">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Subject> _subjects = new();
    private Subject _form = new();
    private bool _showForm;

    protected override async Task OnInitializedAsync() => _subjects = await SubjectSvc.GetAllIncludingInactiveAsync();
    private void Edit(Subject s) { _form = new Subject { Id = s.Id, Name = s.Name, Code = s.Code, Type = s.Type, TotalMarks = s.TotalMarks, PassMarks = s.PassMarks, IsActive = s.IsActive }; _showForm = true; }
    private async Task SaveAsync() { if (_form.Id == 0) await SubjectSvc.CreateAsync(_form); else await SubjectSvc.UpdateAsync(_form); _subjects = await SubjectSvc.GetAllIncludingInactiveAsync(); _showForm = false; }
    private async Task DeleteAsync(int id) { await SubjectSvc.DeleteAsync(id); _subjects = await SubjectSvc.GetAllIncludingInactiveAsync(); }
}
