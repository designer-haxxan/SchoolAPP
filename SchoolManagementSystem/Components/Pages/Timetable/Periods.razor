@page "/timetable/periods"
@rendermode InteractiveServer
@using SchoolManagementSystem.Data.Models
@using SchoolManagementSystem.Services
@inject TimetableService TimetableService
@attribute [Authorize(Policy = "AdminOnly")]

<PageTitle>Manage Periods</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1"><i class="bi bi-clock me-2 text-primary"></i>Manage Periods</h4>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/timetable">Timetable</a></li>
            <li class="breadcrumb-item active">Periods</li>
        </ol></nav>
    </div>
    <button class="btn btn-primary" @onclick="() => OpenModal(null)"><i class="bi bi-plus-lg me-1"></i>Add Period</button>
</div>

@if (isLoading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>#</th><th>Name</th><th>Start Time</th><th>End Time</th><th>Duration</th><th>Type</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in periods.OrderBy(x => x.OrderIndex))
                    {
                        <tr>
                            <td>@p.OrderIndex</td>
                            <td class="fw-semibold">@p.Name</td>
                            <td>@p.StartTime.ToString("hh:mm tt")</td>
                            <td>@p.EndTime.ToString("hh:mm tt")</td>
                            <td>@((int)(p.EndTime - p.StartTime).TotalMinutes) min</td>
                            <td>@(p.IsBreak ? "<span class='badge bg-warning text-dark'>Break</span>" : "<span class='badge bg-primary'>Period</span>")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenModal(p)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(p.Id)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (showModal)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editModel.Id == 0 ? "Add" : "Edit") Period</h5>
                    <button type="button" class="btn-close" @onclick="() => showModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-8">
                            <label class="form-label">Name *</label>
                            <input type="text" class="form-control" @bind="editModel.Name" placeholder="e.g. Period 1" />
                        </div>
                        <div class="col-4">
                            <label class="form-label">Order</label>
                            <input type="number" class="form-control" @bind="editModel.OrderIndex" min="1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Start Time</label>
                            <input type="time" class="form-control" value="@editModel.StartTime.ToString("HH:mm")"
                                   @onchange="e => { if (TimeOnly.TryParse(e.Value?.ToString(), out var t)) editModel.StartTime = t; }" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">End Time</label>
                            <input type="time" class="form-control" value="@editModel.EndTime.ToString("HH:mm")"
                                   @onchange="e => { if (TimeOnly.TryParse(e.Value?.ToString(), out var t)) editModel.EndTime = t; }" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input type="checkbox" class="form-check-input" @bind="editModel.IsBreak" id="isBreak" />
                                <label class="form-check-label" for="isBreak">Is Break</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="Save" disabled="@isSaving">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    List<Period> periods = [];
    Period editModel = new();
    bool isLoading = true, showModal, isSaving;

    protected override async Task OnInitializedAsync()
    {
        periods = await TimetableService.GetPeriodsAsync();
        isLoading = false;
    }

    void OpenModal(Period? p)
    {
        editModel = p != null ? new Period { Id = p.Id, Name = p.Name, StartTime = p.StartTime, EndTime = p.EndTime, OrderIndex = p.OrderIndex, IsBreak = p.IsBreak } : new Period { OrderIndex = periods.Count + 1 };
        showModal = true;
    }

    async Task Save()
    {
        isSaving = true;
        await TimetableService.SavePeriodAsync(editModel);
        periods = await TimetableService.GetPeriodsAsync();
        showModal = false; isSaving = false;
    }

    async Task Delete(int id)
    {
        await TimetableService.DeletePeriodAsync(id);
        periods = await TimetableService.GetPeriodsAsync();
    }
}
