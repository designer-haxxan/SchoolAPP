@page "/finance/expenses"
@rendermode InteractiveServer
@using SchoolManagementSystem.Data.Models
@using SchoolManagementSystem.Services
@inject FinanceService FinanceService
@inject IJSRuntime JS
@attribute [Authorize(Policy = "AccountantOrAdmin")]

<PageTitle>Expenses</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1"><i class="bi bi-wallet2 me-2 text-primary"></i>Expenses</h4>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
            <li class="breadcrumb-item active">Expenses</li>
        </ol></nav>
    </div>
    <button class="btn btn-primary" @onclick="() => OpenModal(null)"><i class="bi bi-plus-lg me-1"></i>Add Expense</button>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <select class="form-select" @bind="filterCategoryId">
                    <option value="0">All Categories</option>
                    @foreach (var c in categories)
                    { <option value="@c.Id">@c.Name</option> }
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" class="form-control" @bind="filterFrom" />
            </div>
            <div class="col-md-2">
                <input type="date" class="form-control" @bind="filterTo" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" @onclick="Load">Filter</button>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-success w-100" @onclick="ExportExcel"><i class="bi bi-file-earmark-excel me-1"></i>Export</button>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h6>Total Expenses</h6>
                    <h4>PKR @expenses.Sum(e => e.Amount).ToString("N0")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h6>Records</h6>
                    <h4>@expenses.Count</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Date</th><th>Category</th><th>Description</th><th>Paid To</th><th>Amount</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in expenses.OrderByDescending(x => x.ExpenseDate))
                    {
                        <tr>
                            <td>@e.ExpenseDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge bg-secondary">@e.ExpenseCategory?.Name</span></td>
                            <td>@e.Description</td>
                            <td>@e.PaidTo</td>
                            <td class="fw-semibold text-danger">PKR @e.Amount.ToString("N0")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenModal(e)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(e.Id)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (showModal)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editModel.Id == 0 ? "Add" : "Edit") Expense</h5>
                    <button type="button" class="btn-close" @onclick="() => showModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Category *</label>
                            <select class="form-select" @bind="editModel.ExpenseCategoryId">
                                <option value="0">Select...</option>
                                @foreach (var c in categories)
                                { <option value="@c.Id">@c.Name</option> }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description *</label>
                            <input type="text" class="form-control" @bind="editModel.Description" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Amount *</label>
                            <input type="number" class="form-control" @bind="editModel.Amount" min="0" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Date *</label>
                            <input type="date" class="form-control" @bind="editModel.ExpenseDate" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Paid To</label>
                            <input type="text" class="form-control" @bind="editModel.PaidTo" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="Save" disabled="@isSaving">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    List<Expense> expenses = [];
    List<ExpenseCategory> categories = [];
    Expense editModel = new() { ExpenseDate = DateOnly.FromDateTime(DateTime.Today) };
    int filterCategoryId;
    DateTime filterFrom = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    DateTime filterTo = DateTime.Today;
    bool isLoading = true, showModal, isSaving;

    protected override async Task OnInitializedAsync()
    {
        categories = await FinanceService.GetExpenseCategoriesAsync();
        await Load();
    }

    async Task Load()
    {
        isLoading = true;
        expenses = await FinanceService.GetExpensesAsync(filterCategoryId == 0 ? null : filterCategoryId, filterFrom, filterTo);
        isLoading = false;
    }

    void OpenModal(Expense? e)
    {
        editModel = e != null ? new Expense { Id = e.Id, ExpenseCategoryId = e.ExpenseCategoryId, Description = e.Description, Amount = e.Amount, ExpenseDate = e.ExpenseDate, PaidTo = e.PaidTo } : new Expense { ExpenseDate = DateOnly.FromDateTime(DateTime.Today) };
        showModal = true;
    }

    async Task Save()
    {
        isSaving = true;
        await FinanceService.SaveExpenseAsync(editModel);
        await Load(); showModal = false; isSaving = false;
    }

    async Task Delete(int id) { await FinanceService.DeleteExpenseAsync(id); await Load(); }

    async Task ExportExcel()
    {
        var bytes = await FinanceService.ExportExpensesToExcelAsync(filterFrom, filterTo);
        await JS.InvokeVoidAsync("downloadFile", "expenses.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
    }
}
